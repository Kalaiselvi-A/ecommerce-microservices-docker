    @Override
    public OrderResponseDTO createOrder(OrderRequestDTO request) {

        Order order = new Order();
        order.setUserId(request.getUserId());

        List<OrderItem> orderItems = new ArrayList<>();
        double totalAmount = 0;

        for (OrderItemRequestDTO itemDTO : request.getItems()) {

            OrderItem item = new OrderItem();
            item.setProductId(itemDTO.getProductId());
            item.setQuantity(itemDTO.getQuantity());

//            // Temporary price (will come from Product Service later)
//            double price = 100.0;
//            item.setPrice(price);
//            totalAmount += price * itemDTO.getQuantity();

//            String productServiceUrl =
//                    "http://localhost:8082/api/products/" + itemDTO.getProductId();
            
//            String url = productServiceUrl + "/" + itemDTO.getProductId();
//            
//            ProductResponse productResponse;
//
//            try {
//                productResponse = restTemplate.getForObject(
//                		url,
//                        ProductResponse.class
//                );
//            } catch (Exception ex) {
//            	 throw new ProductServiceException(
//            		        "Product Service is unavailable. Please try again later."
//            		    );
//            }

            ProductResponse productResponse;
            
            try {
              productResponse = getProductById(itemDTO.getProductId());
              
            } catch (Exception ex) {
          	 throw new ProductServiceException(
          		        "Product Service is unavailable. Please try again later."
          		    );
          	 }
            
            if (productResponse == null) {
            	throw new ProductServiceException(
            	        "Product not found with id: " + itemDTO.getProductId()
            	    );
            }

            double price = productResponse.getPrice();
            item.setPrice(price);

            totalAmount += price * itemDTO.getQuantity();
        
            
            item.setOrder(order);
            orderItems.add(item);
        }

        order.setItems(orderItems);
        order.setTotalAmount(totalAmount);

        Order savedOrder = orderRepository.save(order);
        return mapToResponse(savedOrder);
    }

    // Product Call Logic in Separate Method
    @CircuitBreaker(name = "productService", fallbackMethod = "productServiceFallback")
    public ProductResponse getProductById(Long productId) {
    	
    	String url = productServiceUrl + "/" + productId;
    	
    	return restTemplate.getForObject(url, ProductResponse.class);
	}

    // Fallback Method
    public ProductResponse productServiceFallback(Long productId, Throwable ex) {

        throw new ProductServiceException(
                "Product Service is currently unavailable. Please try again later."
        );
    }

    
	@Override
    public OrderResponseDTO getOrderById(Long orderId) {
        Order order = orderRepository.findById(orderId)
                .orElseThrow(() -> new OrderNotFoundException("Order not found with id " + orderId));
        return mapToResponse(order);
    }

    private OrderResponseDTO mapToResponse(Order order) {

        OrderResponseDTO response = new OrderResponseDTO();
        response.setOrderId(order.getId());
        response.setUserId(order.getUserId());
        response.setStatus(order.getStatus());
        response.setTotalAmount(order.getTotalAmount());
        response.setCreatedAt(order.getCreatedAt());

        List<OrderItemResponseDTO> itemResponses = new ArrayList<>();
        for (OrderItem item : order.getItems()) {
            OrderItemResponseDTO dto = new OrderItemResponseDTO();
            dto.setProductId(item.getProductId());
            dto.setQuantity(item.getQuantity());
            dto.setPrice(item.getPrice());
            itemResponses.add(dto);
        }

        response.setItems(itemResponses);
        return response;
    }
}
